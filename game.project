[bootstrap]
main_collection = /main/main.collectionc
render = /render/game.renderc

[script]
shared_state = 1

[display]
width = 720
height = 1440
high_dpi = 1
display_profiles = /config/game.display_profilesc

[android]
input_method = HiddenInputField
app_icon_48x48 = /assets/app_icons/mipmap-mdpi/ic_launcher.png
app_icon_72x72 = /assets/app_icons/mipmap-hdpi/ic_launcher.png
app_icon_96x96 = /assets/app_icons/mipmap-xhdpi/ic_launcher.png
app_icon_144x144 = /assets/app_icons/mipmap-xxhdpi/ic_launcher.png
app_icon_192x192 = /assets/app_icons/mipmap-xxxhdpi/ic_launcher.png
package = com.blendjam.superttt
manifest = /config/AndroidManifest.xml
version_code = 4
immersive_mode = 1
minimum_sdk_version = 23
app_icon_36x36 = /assets/app_icons/mipmap-ldpi/ic_launcher.png

[html5]
scale_mode = fit
show_fullscreen_button = 1
show_made_with_defold = 1
cssfile = /builtins/manifests/web/dark_theme.css

[project]
title = SuperTicTacToe
write_log = 0
bundle_resources = /assets/bundle
version = 0.2.2
publisher = blendjam
developer = blendjam
dependencies#0 = https://github.com/Insality/druid/archive/refs/tags/1.1.6.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/13.zip

[render]
clear_color_red = 1.0
clear_color_green = 1.0
clear_color_blue = 1.0

[sprite]
max_count = 256

[ios]
bundle_identifier = com.blendjam.superttt

[osx]
bundle_identifier = com.blendjam.superttt

